# ============================================================
# FaFa 日记 .gitignore
# 依据 docs/项目初步设计.md 的技术栈编写：
#   Java 21 / Spring Boot（Maven 或 Gradle）、MySQL、Redis、
#   RocketMQ、Qdrant、Dubbo、Sa-Token、Nacos、Prometheus；
#   Python / FastAPI / LangChain / LangGraph（AI 服务）；
#   Android（Kotlin / AndroidX / Gradle）；iOS（Swift / UIKit）；
#   P2 可选 Unity 3D。
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/
.history/
.sts4-cache/
.factorypath
*.code-workspace
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/
bin/
*.swp
*.swo
*~

# ---------- 环境变量与密钥（百炼 API Key、OSS、MySQL 等）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.p8
*.jks
*.keystore
!keystore-placeholder.jks
keystore.properties
signing.properties
secrets.properties
application-local.yml
application-local.yaml
application-local.properties

# ---------- Java / Spring Boot ----------
target/
out/
*.class
*.war
*.ear
*.nar
*.hprof
hs_err_pid*
replay_pid*
# Maven Release / flatten 插件的临时产物
dependency-reduced-pom.xml
.flattened-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.bak

# ---------- Gradle ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Maven Wrapper ----------
!.mvn/wrapper/maven-wrapper.properties

# ---------- Python / FastAPI（AI 服务）----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
pip-wheel-metadata/
*.whl
.installed.cfg
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/
.langgraph_api/
.langgraph_runtime/

# ---------- Android（Kotlin / AndroidX）----------
local.properties
captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.apk
*.aab
*.ap_
*.dex
*.hprof
output.json

# ---------- iOS（Swift / UIKit / Xcode）----------
DerivedData/
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM
*.dSYM.zip
Pods/
.swiftpm/
*.xcresult

# ---------- Unity（P2 可选 3D 形象）----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
*.unityproj

# ---------- 日志与运行时数据 ----------
logs/
*.log
*.log.*
qdrant_storage/
# 中间件本地数据卷（deploy 下按需启动时生成）
deploy/**/data/
deploy/**/volumes/

# ---------- 前端工具链（如后续引入脚本/原型工具）----------
node_modules/
dist/
.next/
.nuxt/
.vite/
.turbo/
.cache/
coverage/
*.tsbuildinfo
.eslintcache

# ---------- 临时文件 / 系统残留 ----------
*.tmp
*.temp
*.bak
*.orig
*.rej
~$*
*.crdownload
*.part
.Trash-*

# ---------- 本地工具/素材目录（仅根目录，避免误伤 Android src/main/assets）----------
.agents/
/assets/

docs/design-v2.1/
# 设计稿压缩包（219MB，超出 GitHub/Gitee 单文件上限，走对象存储或本地留存）
docs/design-v2.1.rar

# ---------- 含明文凭据的内部文档（禁止入库/推送到远端仓库）----------
# 该文档记录开发环境 MySQL/Redis/Nacos/RabbitMQ/COS/SMTP 明文账号密码，
# 仅限本地留存；团队共享请走密码管理工具。
docs/FaFa_中间件环境与账号信息_v1.0.md

# ---------- 部署时的本地变量（凭据不进库，模板见 deploy/.env.example）----------
deploy/.env

# ---------- Jenkins 拉取 Gitee 用的部署私钥（仅在服务器上生成，禁止入库）----------
deploy/jenkins/ssh/
.screenshots/
docs/FaFa.pen
