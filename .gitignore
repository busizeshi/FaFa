# ============================================================
# FaFa 日记 .gitignore
# 依据 docs/项目初步设计.md 的技术栈编写：
#   Java 21 / Spring Boot（Maven 或 Gradle）、MySQL、Redis、
#   RocketMQ、Qdrant、Dubbo、Sa-Token、Nacos、Prometheus；
#   Python / FastAPI / LangChain / LangGraph（AI 服务）；
#   Android（Kotlin / AndroidX / Gradle）；iOS（Swift / UIKit）；
#   P2 可选 Unity 3D。
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ---------- IDE / 编辑器 ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.classpath
.project
.settings/
bin/
*.swp
*~

# ---------- 环境变量与密钥（百炼 API Key、OSS、MySQL 等）----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
!keystore-placeholder.jks
application-local.yml
application-local.yaml
application-local.properties

# ---------- Java / Spring Boot ----------
target/
out/
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---------- Gradle ----------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---------- Maven Wrapper ----------
!.mvn/wrapper/maven-wrapper.properties

# ---------- Python / FastAPI（AI 服务）----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/
.langgraph_api/
.langgraph_runtime/

# ---------- Android（Kotlin / AndroidX）----------
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output.json

# ---------- iOS（Swift / UIKit / Xcode）----------
DerivedData/
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM
*.dSYM.zip
Pods/
.swiftpm/
*.xcresult

# ---------- Unity（P2 可选 3D 形象）----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
*.unityproj

# ---------- 日志与运行时数据 ----------
logs/
*.log
qdrant_storage/

# ---------- 前端工具链（如后续引入脚本/原型工具）----------
node_modules/
dist/

.agents/
assets/
