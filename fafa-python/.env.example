# ==================================================================
# FaFa Python AI 服务环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env（已被 .gitignore 忽略，不会提交）；
#   2. 按需填写真实值；所有变量均带 FAFA_ 前缀（见 config/settings.py）；
#   3. 账密来源：《FaFa_中间件环境与账号信息_v1.0.md》。
# ==================================================================

# ---- 应用 ----
FAFA_ENVIRONMENT=dev
FAFA_LOG_LEVEL=INFO
FAFA_SERVER_HOST=0.0.0.0
FAFA_SERVER_PORT=8090

# ---- Java biz 服务（内网 REST 入口；AI 结果回传与授权数据获取） ----
FAFA_BIZ_API_BASE_URL=http://192.168.1.254:8081
# 内部服务身份凭据（biz 侧签发短时凭据后填入；认证模块实施前留空）
FAFA_BIZ_API_TOKEN=

# ---- RabbitMQ（AI Worker 任务队列；Python 不直连业务 MySQL） ----
# vhost=/fafa，密码见中间件文档 §4.4
FAFA_RABBITMQ_URL=amqp://fafa:FafaRabbit2026!@192.168.1.254:5672/%2Ffafa

# ---- Qdrant（语义索引；服务器尚未部署，见中间件文档 §9 待办） ----
FAFA_QDRANT_URL=http://192.168.1.254:6333

# ---- 阿里云 DashScope（Qwen 模型；密钥仅经环境变量注入，禁止入库） ----
FAFA_DASHSCOPE_API_KEY=

# ---- 对象存储：开发期 MinIO（正式对象存储为腾讯云 COS，见中间件文档 §5.1） ----
# 开发期（MinIO，本地容器）：
FAFA_MINIO_ENDPOINT=192.168.1.254:9000
FAFA_MINIO_ACCESS_KEY=minioadmin
FAFA_MINIO_SECRET_KEY=minioadmin123
FAFA_MINIO_BUCKET=fafa-dev-media
# 正式对象存储（腾讯云 COS，桶 fafa-dev-2026-1335105367 / ap-guangzhou）：
# 凭据注入 COS_SECRET_ID / COS_SECRET_KEY 环境变量；SDK cos-python-sdk-v5 在 M06 接入
# COS_SECRET_ID=
# COS_SECRET_KEY=

# ---- 模型调用约束（架构规范 §6.6：按模型/超时/限额配置化） ----
FAFA_MODEL_NAME=qwen-plus
FAFA_MODEL_TIMEOUT_SECONDS=60
