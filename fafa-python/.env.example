# 本地敏感配置模板：复制为 .env 后使用（.env 已 gitignore）

# 阿里云百炼
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型映射（用途 -> 模型名）
MODEL_CHAT_LIGHT=qwen-flash
MODEL_CHAT_DEEP=qwen-plus
MODEL_MEDIA_QUERY=qwen-turbo
MODEL_VISION=qwen-vl-plus
MODEL_EMBED_MULTIMODAL=qwen3-vl-embedding
MODEL_EMBED_TEXT=text-embedding-v4
VIDEO_EMBEDDING_FPS=1.0

# Qdrant
QDRANT_URL=http://192.168.1.14:6333
QDRANT_API_KEY=

# fafa-java
JAVA_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=fafa-internal-dev-2026
TOOL_TIMEOUT_SECONDS=8
AGENT_TIMEOUT_SECONDS=45
MAX_TOOL_CALLS=5
MEDIA_SEARCH_LIMIT=20

# 日志
LOG_PATH=./logs/fafa-python

# RocketMQ 消费者（仅 Linux）
CONSUMER_ENABLED=false
ROCKETMQ_NAMESRV=

# Phase 4 素材分析
RECOGNITION_THRESHOLD=0.85
SEARCH_SCORE_THRESHOLD=0.30
CALLBACK_RETRY=3
FOOD_RECOGNITION_PROMPT_VERSION=food-recognition-v1
FOOD_RECOGNITION_MAX_IMAGE_BYTES=10485760
FOOD_RECOGNITION_TIMEOUT_SECONDS=90
