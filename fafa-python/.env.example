# FaFa Python AI Service - 环境变量配置示例
# 复制此文件为 .env 并修改配置

# ==================== 基础配置 ====================
ENVIRONMENT=development
DEBUG=true

# ==================== 通义千问 API ====================
# 请到 https://dashscope.console.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# AI 模型配置
AI_MODEL=qwen-plus
AI_VISION_MODEL=qwen-vl-plus
AI_EMBEDDING_MODEL=text-embedding-v2

# ==================== MySQL 配置 ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fafa
MYSQL_USERNAME=fafa
MYSQL_PASSWORD=fafa_123456

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# ==================== Qdrant 向量数据库 ====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=fafa_photos
QDRANT_GRPC_PORT=6334

# ==================== RocketMQ 配置 ====================
ROCKETMQ_HOST=localhost
ROCKETMQ_PORT=9876
ROCKETMQ_NAME_SERVER=localhost:9876

# RocketMQ Topics
ROCKETMQ_TOPIC_PHOTO_ANALYSIS=photo-analysis
ROCKETMQ_TOPIC_REPORT_GENERATION=report-generation

# RocketMQ Consumer Groups
ROCKETMQ_CONSUMER_GROUP_PHOTO=fafa-photo-consumer
ROCKETMQ_CONSUMER_GROUP_REPORT=fafa-report-consumer

# ==================== Java 服务地址 ====================
JAVA_SERVICE_URL=http://localhost:8080/api

# ==================== 服务配置 ====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ==================== 日志配置 ====================
LOG_LEVEL=DEBUG
LOG_FILE=logs/fafa-python.log
