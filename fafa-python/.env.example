# 环境变量配置示例
# 复制此文件为 .env 并修改配置

# 通义千问 API Key
DASHSCOPE_API_KEY=your_api_key_here

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=fafa
MYSQL_USERNAME=root
MYSQL_PASSWORD=password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Qdrant 配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=fafa_photos

# RocketMQ 配置
ROCKETMQ_HOST=localhost
ROCKETMQ_PORT=9876

# Java 服务地址
JAVA_SERVICE_URL=http://localhost:8080
