# 复制为 .env 并填入真实值（.env 不入库）

# 阿里云百炼 API Key
FAFA_DASHSCOPE_API_KEY=

# 模型路由（换模型只改这里）
FAFA_MODEL_CHAT_LIGHT=qwen-turbo
FAFA_MODEL_CHAT_DEEP=qwen-plus
FAFA_MODEL_VISION=qwen-vl-plus
FAFA_MODEL_EMBED_TEXT=text-embedding-v4
FAFA_MODEL_EMBED_MULTIMODAL=qwen3-vl-embedding

# Qdrant
FAFA_QDRANT_URL=http://127.0.0.1:6333

# Java 服务（回调 / Agent 工具取数）
FAFA_JAVA_BASE_URL=http://127.0.0.1:8080
FAFA_INTERNAL_TOKEN=dev-internal-token

# 日志输出目录
FAFA_LOG_PATH=./logs/fafa-python
