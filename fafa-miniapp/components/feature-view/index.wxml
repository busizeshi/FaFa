<view class="page feature-page">
  <view class="feature-header"><view class="feature-kicker">{{description}}</view><view class="feature-title">{{title}}</view></view>
  <view wx:if="{{error}}" class="error-banner feature-error">{{error}}</view>
  <view wx:if="{{loading}}" class="feature-loading"><view class="loading-dot"></view><text>正在加载资料…</text></view>
  <block wx:else>
    <view wx:if="{{summary}}" class="feature-summary card">{{summary}}</view>
    <view wx:if="{{actions.length}}" class="feature-actions"><button wx:for="{{actions}}" wx:key="id" class="{{item.primary ? 'primary-button' : 'secondary-button'}} action-button" data-action="{{item.id}}" bindtap="onAction">{{item.label}}</button></view>
    <view wx:if="{{fields.length}}" class="feature-form card">
      <block wx:for="{{fields}}" wx:key="key">
        <view wx:if="{{item.type === 'photos'}}" class="field photo-field"><text class="field-label">{{item.label}}</text><view class="photo-slots"><view wx:for="{{photoSlots}}" wx:key="*this" class="photo-slot" data-index="{{index}}" bindtap="onChoosePhoto"><image wx:if="{{photoPaths[index]}}" src="{{photoPaths[index]}}" mode="aspectFill"/><text wx:else class="photo-plus">＋</text><text class="slot-label">{{index === 0 ? '头像' : index === 1 ? '正面' : '侧面'}}</text></view></view><text class="field-hint">请按顺序上传三张清晰照片</text></view>
        <view wx:elif="{{item.type === 'select'}}" class="field"><text class="field-label">{{item.label}}</text><picker range="{{item.optionLabels}}" data-key="{{item.key}}" bindchange="onSelect"><view class="field-input select-value">{{item.displayValue || form[item.key] || item.placeholder || '请选择'}}</view></picker></view>
        <view wx:elif="{{item.type === 'choices'}}" class="field"><text class="field-label">{{item.label}}</text><view class="choice-list"><text wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="choice-chip {{form[item.key] === option.value ? 'selected' : ''}}" data-key="{{item.key}}" data-value="{{option.value}}" bindtap="onChoice">{{option.label}}</text></view></view>
        <view wx:elif="{{item.type === 'textarea'}}" class="field"><text class="field-label">{{item.label}}</text><textarea class="field-area" data-key="{{item.key}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" maxlength="{{item.maxlength || 500}}" bindinput="onInput" /></view>
        <view wx:elif="{{item.type === 'date'}}" class="field"><text class="field-label">{{item.label}}</text><picker mode="date" data-key="{{item.key}}" value="{{form[item.key]}}" bindchange="onInput"><view class="field-input select-value">{{form[item.key] || item.placeholder || '请选择日期'}}</view></picker></view>
        <view wx:elif="{{item.type === 'time'}}" class="field"><text class="field-label">{{item.label}}</text><picker mode="time" data-key="{{item.key}}" value="{{form[item.key]}}" bindchange="onInput"><view class="field-input select-value">{{form[item.key] || item.placeholder || '选择时间'}}</view></picker></view>
        <view wx:else class="field"><text class="field-label">{{item.label}}</text><input class="field-input" data-key="{{item.key}}" type="{{item.type === 'number' ? 'digit' : 'text'}}" value="{{form[item.key]}}" placeholder="{{item.placeholder}}" maxlength="{{item.maxlength || 120}}" bindinput="onInput" /></view>
      </block>
      <button class="primary-button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSubmit">{{saving ? '正在保存…' : '保存'}}</button>
    </view>
    <view wx:if="{{pageKey === 'media-upload' && uploadPaths.length}}" class="upload-preview card"><image wx:for="{{uploadPaths}}" wx:key="*this" src="{{item}}" mode="aspectFill"/><text>{{uploadPaths.length}} 项待上传</text></view>
    <view wx:if="{{rows.length}}" class="feature-rows">
      <view class="feature-row card" wx:for="{{rows}}" wx:key="id" data-index="{{index}}" bindtap="onRowTap"><image wx:if="{{item.imageUrl}}" class="row-image" src="{{item.imageUrl}}" mode="aspectFill"/><view class="row-body"><view class="row-title">{{item.title}}</view><view wx:if="{{item.subtitle}}" class="row-subtitle">{{item.subtitle}}</view><view wx:if="{{item.meta}}" class="row-meta">{{item.meta}}</view></view><button wx:if="{{item.actionLabel}}" class="row-action" data-index="{{index}}" bindtap="onRowAction">{{item.actionLabel}}</button><text wx:elif="{{item.chevron}}" class="row-chevron">›</text></view>
    </view>
    <button wx:if="{{pageKey === 'photo-search' && hasMore}}" class="secondary-button load-more-button" loading="{{saving}}" bindtap="onLoadMore">加载更多</button>
    <view wx:if="{{!rows.length && !fields.length}}" class="feature-empty card"><view class="empty-icon">♡</view><view class="empty-title">这里还没有记录</view><view class="empty-copy">有新的资料时，会在这里出现。</view></view>
  </block>
</view>
