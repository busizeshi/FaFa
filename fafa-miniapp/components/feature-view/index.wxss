.feature-page { padding-top: 22rpx; padding-bottom: calc(50rpx + env(safe-area-inset-bottom)); }
.feature-header { margin-bottom: 26rpx; }
.feature-kicker { color: #809083; font-size: 22rpx; }
.feature-title { margin-top: 5rpx; color: #293A31; font-size: 40rpx; line-height: 1.3; font-weight: 700; }
.feature-error { margin: 16rpx 0; }
.feature-loading { display: flex; min-height: 220rpx; align-items: center; justify-content: center; gap: 14rpx; color: #819084; font-size: 23rpx; }
.loading-dot { width: 15rpx; height: 15rpx; border-radius: 50%; background: #70A07A; }
.feature-summary { padding: 24rpx; margin: 16rpx 0; color: #526555; font-size: 25rpx; line-height: 1.6; white-space: pre-wrap; }
.feature-actions { display: flex; gap: 12rpx; margin: 18rpx 0; }
.action-button { flex: 1; min-height: 78rpx; border-radius: 22rpx; font-size: 24rpx; }
.feature-form { display: flex; flex-direction: column; gap: 24rpx; padding: 26rpx 22rpx; }
.select-value { display: flex; min-height: 78rpx; align-items: center; color: #516153; }
.field-hint { color: #8B978B; font-size: 20rpx; }
.choice-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.choice-chip { padding: 13rpx 20rpx; border: 1rpx solid #E0E8DD; border-radius: 999rpx; background: #fff; color: #6D7E70; font-size: 22rpx; }
.choice-chip.selected { border-color: #77A180; background: #EAF3E8; color: #3E7A52; }
.photo-slots { display: flex; gap: 14rpx; }
.upload-preview { display: flex; align-items: center; gap: 10rpx; padding: 14rpx; margin-top: 16rpx; color: #718072; font-size: 21rpx; }
.upload-preview image { width: 68rpx; height: 68rpx; border-radius: 12rpx; background: #E8EEE5; }
.photo-slot { position: relative; display: flex; flex: 1; height: 172rpx; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; border: 1rpx dashed #B9C9B9; border-radius: 20rpx; background: #F7F9F4; color: #7D9380; }
.photo-slot image { position: absolute; inset: 0; width: 100%; height: 100%; }
.photo-plus { font-size: 40rpx; }
.slot-label { position: absolute; right: 0; bottom: 0; left: 0; padding: 4rpx 0; background: rgba(255,255,255,.84); color: #596C5B; text-align: center; font-size: 20rpx; }
.submit-button { margin-top: 4rpx; }
.feature-rows { display: flex; flex-direction: column; gap: 14rpx; margin-top: 18rpx; }
.feature-row { display: flex; min-height: 116rpx; align-items: center; padding: 18rpx; }
.row-image { width: 92rpx; height: 92rpx; border-radius: 20rpx; background: #EEF2EA; }
.row-body { flex: 1; min-width: 0; }
.row-title { color: #314034; font-size: 27rpx; font-weight: 650; }
.row-subtitle { margin-top: 4rpx; color: #708073; font-size: 22rpx; }
.row-meta { margin-top: 4rpx; color: #95A095; font-size: 20rpx; }
.row-action { padding: 12rpx 17rpx; border-radius: 999rpx; background: #EAF3E8; color: #3E7A52; font-size: 20rpx; }
.row-chevron { margin-left: 14rpx; color: #A0AAA0; font-size: 38rpx; }
.feature-empty { margin-top: 20rpx; padding: 54rpx 28rpx; text-align: center; }
.load-more-button { margin: 20rpx auto 36rpx; }
.empty-icon { color: #79A080; font-size: 48rpx; }
.empty-title { margin-top: 10rpx; font-size: 28rpx; font-weight: 650; }
.empty-copy { margin-top: 5rpx; color: #869287; font-size: 21rpx; }
