.tab-shell { position: fixed; z-index: 99; right: 0; bottom: 0; left: 0; padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); border-top: 1rpx solid #E8EEE6; }
.tab-list { display: flex; justify-content: space-around; align-items: center; height: 88rpx; }
.tab-item { display: flex; min-width: 100rpx; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; color: #7A897D; }
.tab-item.active { color: #3E7A52; }
.tab-symbol { position: relative; width: 42rpx; height: 42rpx; color: currentColor; }
.tab-home::before { content: ''; position: absolute; top: 7rpx; left: 10rpx; width: 20rpx; height: 20rpx; border-top: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(45deg); }
.tab-home::after { content: ''; position: absolute; bottom: 4rpx; left: 9rpx; width: 24rpx; height: 20rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 5rpx 5rpx; }
.tab-album { border: 3rpx solid currentColor; border-radius: 8rpx; background: linear-gradient(currentColor,currentColor) 50% 0/3rpx 100% no-repeat, linear-gradient(currentColor,currentColor) 0 50%/100% 3rpx no-repeat; }
.tab-chat::before { content: ''; position: absolute; top: 5rpx; left: 4rpx; width: 32rpx; height: 25rpx; border: 3rpx solid currentColor; border-radius: 11rpx; }
.tab-chat::after { content: ''; position: absolute; bottom: 4rpx; left: 11rpx; width: 9rpx; height: 9rpx; border-left: 3rpx solid currentColor; transform: skew(-28deg); }
.tab-me::before { content: ''; position: absolute; top: 3rpx; left: 14rpx; width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.tab-me::after { content: ''; position: absolute; bottom: 3rpx; left: 7rpx; width: 26rpx; height: 15rpx; border: 3rpx solid currentColor; border-radius: 18rpx 18rpx 7rpx 7rpx; }
.tab-label { font-size: 20rpx; line-height: 26rpx; }
