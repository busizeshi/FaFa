<view class="tab-shell">
  <view class="tab-list">
    <view wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onTap">
      <view class="tab-symbol tab-{{item.icon}}"></view>
      <text class="tab-label">{{item.text}}</text>
    </view>
  </view>
</view>
