<view class="container">
  <view class="card" wx:if="{{!result}}">
    <view class="title">加入宠物空间</view>
    <input class="input" value="{{invitationId}}" bindinput="inputId" placeholder="邀请ID" />
    <textarea class="input" value="{{token}}" bindinput="inputToken" placeholder="一次性邀请凭证" />
    <button class="primary" loading="{{submitting}}" bindtap="accept">接受邀请</button>
  </view>
  <view class="card" wx:else>
    <view class="title">已加入宠物空间</view>
    <view>角色：{{result.role}}</view>
    <view wx:if="{{result.expiresAt}}">权限到期：{{result.expiresAt}}</view>
  </view>
</view>
