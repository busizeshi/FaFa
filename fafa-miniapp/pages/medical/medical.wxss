.container { padding: 24rpx; }
.header { padding: 24rpx 8rpx 32rpx; }
.header-title { font-size: 40rpx; font-weight: bold; }
.header-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.actions { display: flex; align-items: center; gap: 16rpx; margin-bottom: 28rpx; }
.actions button { flex: 1; font-size: 25rpx; }
.btn-secondary { background: #fff; color: #4caf50; border: 1rpx solid #4caf50; }
.refresh { color: #4caf50; font-size: 24rpx; white-space: nowrap; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #666; margin-bottom: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 12rpx 24rpx; margin-bottom: 16rpx; }
.row { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.row:last-child { border-bottom: none; }
.label { width: 150rpx; color: #999; }
.value { flex: 1; word-break: break-all; }
.alert-card { border-left: 8rpx solid #ffb300; }
.alert-title { font-weight: bold; margin: 8rpx 0; }
.severity { float: right; color: #f57c00; font-size: 24rpx; }
.muted { color: #888; font-size: 24rpx; line-height: 1.7; margin-top: 8rpx; }
.empty { background: #fff; border-radius: 16rpx; padding: 32rpx; text-align: center; color: #999; font-size: 26rpx; }
.summary-card { line-height: 1.8; }
.summary-line { color: #d97706; margin-top: 12rpx; }
