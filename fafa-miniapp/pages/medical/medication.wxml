<view class="form-page">
  <view class="form-title">新增用药计划</view>
  <view class="hint">固定频次先按每天 09:00 生成提醒；需要多次用药时可通过接口传多个 administrationTimes。</view>
  <view class="field"><text>药品 *</text><input placeholder="药品名称" value="{{form.medicationName}}" bindinput="onInput" data-field="medicationName" /></view>
  <view class="field"><text>规格</text><input placeholder="可选" value="{{form.specification}}" bindinput="onInput" data-field="specification" /></view>
  <view class="field"><text>用途</text><input placeholder="可选" value="{{form.purpose}}" bindinput="onInput" data-field="purpose" /></view>
  <view class="field"><text>每次剂量 *</text><input type="digit" placeholder="例如 1" value="{{form.dosageValue}}" bindinput="onInput" data-field="dosageValue" /></view>
  <view class="field"><text>剂量单位</text><input value="{{form.dosageUnit}}" bindinput="onInput" data-field="dosageUnit" /></view>
  <view class="field"><text>频次</text><picker range="{{frequencyOptions}}" bindchange="onFrequencyChange"><view class="picker-value">{{form.frequencyType}}</view></picker></view>
  <view class="field"><text>开始日期</text><view class="picker-value">{{form.startDate}}</view></view>
  <view class="field"><text>结束日期</text><input placeholder="可选 yyyy-MM-dd" value="{{form.endDate}}" bindinput="onInput" data-field="endDate" /></view>
  <view class="field multiline"><text>备注</text><textarea placeholder="可选" value="{{form.notes}}" bindinput="onInput" data-field="notes" /></view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">保存用药计划</button>
</view>
