<view class="form-page">
  <view class="form-title">新增就诊记录</view>
  <view class="field"><text>就诊日期</text><picker mode="date" value="{{form.visitDate}}" bindchange="onInput" data-field="visitDate"><view class="picker-value">{{form.visitDate}}</view></picker></view>
  <view class="field"><text>医院 *</text><input placeholder="请输入医院名称" value="{{form.hospitalName}}" bindinput="onInput" data-field="hospitalName" /></view>
  <view class="field"><text>医生</text><input placeholder="可选" value="{{form.doctorName}}" bindinput="onInput" data-field="doctorName" /></view>
  <view class="field multiline"><text>主诉</text><textarea placeholder="症状、就诊原因" value="{{form.chiefComplaint}}" bindinput="onInput" data-field="chiefComplaint" /></view>
  <view class="field multiline"><text>诊断原文</text><textarea placeholder="按报告或医生记录填写" value="{{form.diagnosis}}" bindinput="onInput" data-field="diagnosis" /></view>
  <view class="field multiline"><text>处方原文</text><textarea placeholder="按处方填写" value="{{form.prescription}}" bindinput="onInput" data-field="prescription" /></view>
  <view class="field multiline"><text>治疗记录</text><textarea placeholder="检查、治疗和医嘱" value="{{form.treatment}}" bindinput="onInput" data-field="treatment" /></view>
  <view class="field"><text>费用</text><input type="digit" placeholder="可选" value="{{form.totalCost}}" bindinput="onInput" data-field="totalCost" /></view>
  <view class="field multiline"><text>备注</text><textarea placeholder="复诊提醒等" value="{{form.notes}}" bindinput="onInput" data-field="notes" /></view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">保存就诊记录</button>
</view>
