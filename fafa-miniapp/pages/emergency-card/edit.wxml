<view class="container">
  <view class="card">
    <view class="hint">资料仅由宠物主人维护，保存后协作者可读取。</view>
    <input class="input" placeholder="血型" value="{{form.bloodType}}" data-field="bloodType" bindinput="input" />
    <textarea class="input area" placeholder="过敏史" value="{{form.allergies}}" data-field="allergies" bindinput="input" />
    <textarea class="input area" placeholder="慢性病记录" value="{{form.chronicConditions}}" data-field="chronicConditions" bindinput="input" />
    <input class="input" placeholder="紧急联系人姓名" value="{{form.emergencyContactName}}" data-field="emergencyContactName" bindinput="input" />
    <input class="input" placeholder="紧急联系人电话" value="{{form.emergencyContactPhone}}" data-field="emergencyContactPhone" bindinput="input" />
    <input class="input" placeholder="常去医院" value="{{form.primaryHospitalName}}" data-field="primaryHospitalName" bindinput="input" />
    <input class="input" placeholder="医院电话" value="{{form.primaryHospitalPhone}}" data-field="primaryHospitalPhone" bindinput="input" />
    <input class="input" placeholder="医院地址" value="{{form.primaryHospitalAddress}}" data-field="primaryHospitalAddress" bindinput="input" />
    <textarea class="input area" placeholder="补充备注" value="{{form.notes}}" data-field="notes" bindinput="input" />
    <button class="primary" bindtap="save">保存应急资料</button>
  </view>
</view>
