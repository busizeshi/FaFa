<view class="container">
  <view class="card" wx:if="{{card}}">
    <view class="title">{{card.pet.name || '未命名宠物'}}的应急信息</view>
    <view class="row">品种：{{card.pet.breed || '未填写'}}</view>
    <view class="row">血型：{{card.profile.bloodType || '未填写'}}</view>
    <view class="row">过敏史：{{card.profile.allergies || '未填写'}}</view>
    <view class="row">慢性病：{{card.profile.chronicConditions || '未填写'}}</view>
    <view class="row">联系人：{{card.emergencyContact.name || '未填写'}} {{card.emergencyContact.phone || ''}}</view>
    <view class="row">医院：{{card.primaryHospital.name || '未填写'}}</view>
    <view class="row">医院电话：{{card.primaryHospital.phone || ''}}</view>
    <view class="notice">资料由用户维护，请在使用前确认有效</view>
    <button class="primary" bindtap="saveImage">生成图片并保存</button>
    <button bindtap="callContact" wx:if="{{card.emergencyContact.phone}}">拨打紧急联系人</button>
    <button bindtap="edit">编辑资料（仅主人）</button>
  </view>
  <canvas canvas-id="emergencyCard" class="canvas"></canvas>
</view>
