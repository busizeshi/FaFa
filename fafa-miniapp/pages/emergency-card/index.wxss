.container { padding: 24rpx; background: #f6f8f7; min-height: 100vh; }
.card { background: #fff; border-radius: 18rpx; padding: 32rpx; }
.title { font-size: 38rpx; font-weight: 600; margin-bottom: 24rpx; color: #2f7d4f; }
.row { padding: 18rpx 0; border-bottom: 1rpx solid #eef1ef; font-size: 28rpx; }
.notice { color: #9b6e15; background: #fff6dc; padding: 18rpx; margin: 26rpx 0; font-size: 24rpx; }
.primary { color: #fff; background: #4caf50; }
.canvas { position: fixed; left: -2000rpx; top: -2000rpx; width: 650px; height: 900px; }
