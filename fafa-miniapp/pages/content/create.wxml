<view class="container"><view class="header"><view class="title">生成分享草稿</view><view class="muted">先生成可编辑草稿，不会自动发布</view></view><view class="card"><picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="changeType"><view>内容类型：{{types[typeIndex]}}</view></picker><input placeholder="可选主题" value="{{customTopic}}" bindinput="inputTopic"/><button class="primary" loading="{{loading}}" bindtap="create">生成草稿</button></view><view class="card" wx:if="{{draft}}"><view class="section-title">{{draft.draft.title}}</view><textarea value="{{draft.draft.body}}" auto-height bindinput="editBody"></textarea><view class="muted">{{draft.status}} · 保存前请确认内容和素材</view><button bindtap="save">保存修改</button></view></view>
