<view class="container"><view class="header"><view class="title">周期生成设置</view><view class="muted">到期后只生成草稿，不会自动发布</view></view><view class="card"><picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="changeType"><view>内容类型：{{types[typeIndex]}}</view></picker><picker mode="selector" range="{{intervalNames}}" value="{{intervalIndex}}" bindchange="changeInterval"><view>生成间隔：{{intervalNames[intervalIndex]}}</view></picker><button class="primary" bindtap="save">保存设置</button></view><view class="card" wx:for="{{schedules}}" wx:key="id"><view>{{item.contentType}} · 每 {{item.intervalDays}} 天</view><view class="muted">下次：{{item.nextRunAt}} · {{item.enabled ? '已启用' : '已停用'}}</view><button size="mini" bindtap="toggle" data-id="{{item.id}}">{{item.enabled ? '停用' : '启用'}}</button></view></view>
