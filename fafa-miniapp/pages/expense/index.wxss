.container { padding: 24rpx; }
.header { padding: 24rpx 8rpx 20rpx; }
.header-title { font-size: 40rpx; font-weight: bold; }
.header-sub, .muted { color: #888; font-size: 24rpx; margin-top: 8rpx; }
.period-tabs { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; }
.period-tab { flex: 1; padding: 20rpx; text-align: center; color: #888; }
.period-tab.active { color: #4caf50; font-weight: bold; border-bottom: 4rpx solid #4caf50; }
.summary-card, .chart-card, .card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.summary-label, .section-title { color: #666; font-weight: bold; }
.total { color: #4caf50; font-size: 56rpx; font-weight: bold; margin-top: 12rpx; }
.section { margin-bottom: 28rpx; }
.chart-card { display: flex; align-items: center; }
.pie { width: 220rpx; height: 220rpx; flex-shrink: 0; }
.category-list { flex: 1; margin-left: 16rpx; }
.category-row, .row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #f3f3f3; font-size: 24rpx; }
.category-row:last-child, .row:last-child { border-bottom: none; }
.trend-row { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; font-size: 22rpx; }
.trend-date { width: 150rpx; color: #888; }
.trend-bar { flex: 1; height: 14rpx; background: #edf5ed; border-radius: 8rpx; overflow: hidden; }
.trend-fill { height: 100%; background: #81c784; border-radius: 8rpx; }
.trend-amount { width: 130rpx; text-align: right; }
.label { color: #888; width: 170rpx; }
.value { flex: 1; }
.amount { color: #4caf50; font-weight: bold; }
.refresh { float: right; color: #4caf50; font-weight: normal; font-size: 24rpx; }
.empty { background: #fff; border-radius: 16rpx; padding: 36rpx; text-align: center; color: #999; }
.btn-primary { margin: 24rpx 0; }
