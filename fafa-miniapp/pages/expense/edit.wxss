.container { padding: 24rpx; }
.form-card { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; }
.field { display: flex; align-items: center; min-height: 100rpx; border-bottom: 1rpx solid #f2f2f2; }
.field:last-child { border-bottom: none; }
.label { width: 180rpx; color: #777; }
input, textarea, .picker-value { flex: 1; color: #333; }
textarea { min-height: 130rpx; padding-top: 24rpx; }
.tip { color: #888; font-size: 24rpx; line-height: 1.7; margin: 24rpx 8rpx; }
.btn-primary { margin-top: 24rpx; }
