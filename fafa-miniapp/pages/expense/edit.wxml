<view class="container">
  <view class="form-card">
    <view class="field"><text class="label">分类</text><picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange"><view class="picker-value">{{categories[categoryIndex].label || '请选择'}}</view></picker></view>
    <view class="field"><text class="label">金额（元）</text><input type="digit" placeholder="例如 59.90" value="{{amount}}" bindinput="onAmountInput" /></view>
    <view class="field"><text class="label">发生日期</text><picker mode="date" value="{{expenseDate}}" end="{{expenseDate}}" bindchange="onDateChange"><view class="picker-value">{{expenseDate}}</view></picker></view>
    <view class="field"><text class="label">标题</text><input placeholder="例如 购买猫粮" maxlength="100" value="{{title}}" bindinput="onTitleInput" /></view>
    <view class="field notes"><text class="label">备注</text><textarea placeholder="可选" maxlength="500" value="{{notes}}" bindinput="onNotesInput" /></view>
  </view>
  <view class="tip">当前仅支持人民币（CNY）。系统同步的医疗费用请在就医档案中修改。</view>
  <button class="btn-primary" loading="{{saving}}" bindtap="save">保存开支</button>
</view>
