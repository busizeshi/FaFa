.container {
  padding: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 80rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin: 16rpx 0 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.row:last-child {
  border-bottom: none;
}

.label {
  width: 140rpx;
  color: #999;
}

.value {
  flex: 1;
  word-break: break-all;
}

.code {
  color: #4caf50;
  font-size: 24rpx;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-group button {
  flex: 1;
  font-size: 26rpx;
  padding: 0;
}

.btn-primary {
  background-color: #4caf50;
  color: #fff;
  border-radius: 12rpx;
}

.btn-primary[disabled] {
  background-color: #a5d6a7;
  color: #fff;
}

.btn-copy {
  background-color: #fff;
  color: #4caf50;
  border: 2rpx solid #4caf50;
  border-radius: 12rpx;
}

.btn-copy[disabled] {
  background-color: #f5f5f5;
  color: #bbb;
  border-color: #e0e0e0;
}

.btn-login {
  background-color: #2196f3;
  color: #fff;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.btn-login[disabled] {
  background-color: #90caf9;
  color: #fff;
}

.result {
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #795548;
  margin-bottom: 32rpx;
  word-break: break-all;
}

.tips {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.tips-title {
  font-weight: bold;
  margin-bottom: 12rpx;
}

.tip {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}
