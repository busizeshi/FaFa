.login-page { min-height: 100vh; position: relative; overflow: hidden; background: #F5F7F0; }
.login-cover { position: absolute; top: 0; right: 0; left: 0; height: 58vh; opacity: .92; }
.login-page::after { content: ''; position: absolute; top: 34vh; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(250,251,247,0) 0%, #FAFBF7 22%, #FAFBF7 100%); }
.login-content { position: absolute; z-index: 1; right: 46rpx; bottom: calc(58rpx + env(safe-area-inset-bottom)); left: 46rpx; display: flex; flex-direction: column; align-items: flex-start; }
.brand-mark { margin-bottom: 20rpx; color: #3E7A52; font-family: Georgia, serif; font-size: 30rpx; font-weight: 700; letter-spacing: 3rpx; }
.login-title { color: #293A31; font-size: 54rpx; line-height: 1.32; font-weight: 700; white-space: pre-line; }
.login-copy { margin-top: 18rpx; color: #65796B; font-size: 26rpx; }
.login-button { width: 100%; margin-top: 44rpx; }
.privacy-line { display: flex; flex-wrap: wrap; align-items: center; margin-top: 22rpx; color: #849084; font-size: 21rpx; }
.privacy-link { margin-left: 4rpx; color: #3E7A52; }
.login-error { width: 100%; margin-top: 24rpx; }
