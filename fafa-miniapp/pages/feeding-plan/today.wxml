<view class="container">
  <view class="header">
    <view class="header-title">今日喂食</view>
    <view class="header-sub">完成操作会写入实际喂食记录</view>
  </view>
  <view class="card" wx:if="{{plan}}">
    <view class="row"><text class="label">计划</text><text class="value">{{plan.name || '日常喂食计划'}}</text></view>
    <view class="row"><text class="label">目标总量</text><text class="value">{{plan.dailyTargetAmount || '-'}} {{plan.unit || ''}}</text></view>
  </view>
  <view class="empty" wx:if="{{!plan}}">暂无生效喂食计划</view>
  <view class="card checklist" wx:for="{{checklist.items}}" wx:key="planItemId" wx:for-item="item">
    <view class="row"><text class="label">{{item.plannedAt}}</text><text class="value">{{item.foodName}}</text></view>
    <view class="row"><text class="label">目标量</text><text class="value">{{item.amount}} {{item.unit}}</text></view>
    <button class="btn-primary" wx:if="{{item.completionStatus !== 'completed'}}" data-item="{{item}}" bindtap="completeItem">完成喂食</button>
    <view class="done" wx:else>已完成 · {{item.actualFeedingTime}}</view>
  </view>
</view>
