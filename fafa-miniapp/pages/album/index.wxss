.album-page { padding-top: 28rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.album-heading { margin-bottom: 26rpx; }
.add-button { width: 74rpx; height: 74rpx; border-radius: 24rpx; background: #E8F1E6; color: #3E7A52; font-size: 44rpx; line-height: 70rpx; }
.search-card { display: flex; align-items: center; height: 84rpx; padding: 0 20rpx; border-radius: 24rpx; color: #8B978D; }
.search-icon { font-size: 42rpx; transform: rotate(-20deg); }
.search-placeholder { flex: 1; margin-left: 10rpx; font-size: 24rpx; }
.filter-icon { font-size: 34rpx; }
.photo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 26rpx; }
.photo-tile { position: relative; overflow: hidden; height: 300rpx; border-radius: 24rpx; background: #E9EDE7; }
.photo-tile image { width: 100%; height: 100%; }
.photo-video { width: 100%; height: 100%; }
.video-marker { position: absolute; top: 12rpx; left: 12rpx; padding: 6rpx 12rpx; border-radius: 20rpx; color: #fff; background: rgba(35,45,37,.58); font-size: 19rpx; }
.photo-caption { position: absolute; right: 0; bottom: 0; left: 0; padding: 32rpx 14rpx 12rpx; color: #fff; font-size: 21rpx; background: linear-gradient(transparent, rgba(24,35,26,.55)); }
.empty { margin-top: 34rpx; padding: 70rpx 28rpx; text-align: center; color: #7E8B80; font-size: 24rpx; }
.empty-symbol { color: #8BA590; font-size: 64rpx; }
.empty-title { margin: 12rpx 0 4rpx; color: #293A31; font-size: 30rpx; font-weight: 650; }
.empty-action { margin-top: 28rpx; }
.album-count { margin-top: 20rpx; color: #8A958A; text-align: center; font-size: 20rpx; }
