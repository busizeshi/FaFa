<view class="page album-page">
  <view class="row-between album-heading"><view><view class="page-title">{{pet ? pet.name + '的相册' : '成长相册'}}</view><view class="page-subtitle">把一起生活的日子收进来</view></view><button class="add-button" bindtap="goUpload">＋</button></view>
  <view class="search-card card" bindtap="goSearch"><text class="search-icon">⌕</text><text class="search-placeholder">搜一搜照片里的回忆</text><text class="filter-icon">☷</text></view>
  <view wx:if="{{error}}" class="error-banner" bindtap="onRetry">{{error}}　点击重试</view>
  <view wx:if="{{loading}}" class="empty">正在整理照片…</view>
  <view wx:elif="{{!photos.length}}" class="empty card"><view class="empty-symbol">▧</view><view class="empty-title">相册还空着</view><view>上传第一张照片，留住它的小日常。</view><button class="secondary-button empty-action" bindtap="goUpload">添加照片</button></view>
  <view wx:else class="photo-grid"><view class="photo-tile" wx:for="{{photos}}" wx:key="id" data-id="{{item.id}}" bindtap="onPhotoTap"><video wx:if="{{item.mediaType === 'video'}}" src="{{item.displayUrl}}" class="photo-video" controls="false" show-center-play-btn="false" show-play-btn="false" object-fit="cover"/><image wx:else src="{{item.displayUrl}}" mode="aspectFill" /><view wx:if="{{item.mediaType === 'video'}}" class="video-marker">▶ 视频</view><view class="photo-caption">{{item.petName || item.dateLabel || 'FaFa 相册'}}</view></view></view>
  <view wx:if="{{loadingMore}}" class="album-count">正在加载更多…</view>
  <view wx:elif="{{photos.length && photos.length < total}}" class="album-count">上滑加载更多</view>
  <view class="album-count" wx:if="{{total}}">共 {{total}} 份回忆</view>
</view>
