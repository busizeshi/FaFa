<scroll-view class="page" scroll-y scroll-into-view="{{'message-' + (messages.length - 1)}}">
  <view class="welcome" wx:if="{{!messages.length}}">
    <view class="welcome-title">问问关于宠物的任何事情</view>
    <view class="welcome-sub">我会根据你已经记录的数据回答</view>
  </view>

  <view wx:for="{{messages}}" wx:key="index" id="{{'message-' + index}}" class="message {{item.role}}">
    <view class="bubble">{{item.content}}</view>
    <view wx:if="{{item.blocks && item.blocks.length}}" class="blocks">
      <view wx:for="{{item.blocks}}" wx:for-item="block" wx:key="index" class="block">
        <view wx:if="{{block.type === 'stat'}}" class="stat">{{block.title}}：{{block.value}}{{block.unit}}</view>
        <view wx:elif="{{block.type === 'link'}}" class="link" data-url="{{block.pageUrl}}" bindtap="openDraft">
          {{block.title || '去确认记录'}}
        </view>
        <view wx:elif="{{block.type === 'media'}}" class="media-list">
          <view wx:for="{{block.items}}" wx:for-item="media" wx:key="mediaId">
            <image wx:if="{{media.mediaType === 'photo'}}" class="media-image" mode="aspectFill" src="{{media.fileUrl}}" />
            <video wx:elif="{{media.mediaType === 'video'}}" class="media-video" src="{{media.fileUrl}}" controls="{{true}}" />
          </view>
        </view>
        <view wx:elif="{{block.type === 'chart'}}" class="notice">已生成趋势数据，可在详细页面查看</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">AI 正在查看记录…</view>

  <view wx:if="{{!messages.length && recommendations.length}}" class="recommendations">
    <view class="recommend-title">可以这样问</view>
    <button wx:for="{{recommendations}}" wx:key="id" class="recommend" data-text="{{item.text}}" bindtap="useRecommendation">
      {{item.text}}
    </button>
  </view>
</scroll-view>

<view class="composer">
  <input class="input" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="sendByButton" placeholder="例如：豆包最近体重怎么样？" />
  <button class="send" bindtap="sendByButton" disabled="{{loading}}">发送</button>
</view>
