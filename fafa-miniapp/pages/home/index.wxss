.home-page { padding-top: 22rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.home-top { margin: 4rpx 0 30rpx; }
.eyebrow { color: #829184; font-size: 23rpx; }
.greeting { margin-top: 4rpx; font-size: 38rpx; line-height: 1.35; font-weight: 700; }
.avatar-dot { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; background: #E6F0E4; color: #3E7A52; font-family: Georgia, serif; font-weight: 700; }
.pet-card { display: flex; align-items: center; padding: 22rpx; border-radius: 28rpx; }
.pet-avatar { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 26rpx; background: #F3EDE3; font-size: 44rpx; }
.pet-avatar image { width: 100%; height: 100%; }
.pet-info { flex: 1; min-width: 0; margin-left: 18rpx; }
.pet-name { font-size: 30rpx; font-weight: 700; }
.pet-type { margin-left: 12rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #F2F4EC; color: #708271; font-size: 19rpx; }
.pet-meta { display: block; margin-top: 7rpx; color: #7A897D; font-size: 22rpx; }
.switch-pet, .pet-arrow { padding: 12rpx; color: #708271; font-size: 23rpx; }
.daily-section { margin-top: 38rpx; }
.section-note { margin-top: 4rpx; color: #819083; font-size: 21rpx; }
.text-link { color: #4B865D; font-size: 23rpx; }
.daily-card { display: flex; align-items: center; padding: 24rpx; }
.daily-mark { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 22rpx; background: #EEF2E9; color: #63816A; font-size: 36rpx; }
.daily-mark.done { background: #E4F1E5; color: #3E7A52; }
.daily-copy { flex: 1; margin-left: 18rpx; }
.daily-title { font-size: 26rpx; font-weight: 650; }
.daily-sub { margin-top: 5rpx; color: #839084; font-size: 21rpx; }
.chevron { color: #99A69A; font-size: 38rpx; }
.shortcuts { margin-top: 36rpx; }
.shortcut-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.shortcut { display: flex; min-height: 184rpx; flex-direction: column; align-items: flex-start; justify-content: center; padding: 22rpx; }
.feed-shortcut { background: #F6F0E6; border-color: #EFE6D8; }
.weight-shortcut { background: #EEF4F3; border-color: #E1ECE8; }
.shortcut-icon { margin-bottom: 8rpx; color: #4C8060; font-size: 35rpx; }
.shortcut-title { font-size: 27rpx; font-weight: 650; }
.shortcut-note { margin-top: 4rpx; color: #78877B; font-size: 21rpx; }
.reminder-row { display: flex; align-items: center; padding: 18rpx 20rpx; margin-bottom: 12rpx; }
.reminder-mark { color: #D99A52; font-size: 36rpx; }
.reminder-text { flex: 1; margin-left: 14rpx; }
.reminder-title { font-size: 25rpx; }
.reminder-time { margin-top: 3rpx; color: #879388; font-size: 21rpx; }
.welcome-card { padding: 42rpx 28rpx; text-align: center; }
.welcome-icon { color: #5C9E71; font-size: 54rpx; }
.welcome-title { margin: 10rpx 0; font-size: 31rpx; font-weight: 700; }
.welcome-action { margin-top: 28rpx; }
.bottom-note { margin-top: 40rpx; color: #A0AAA0; text-align: center; font-size: 21rpx; }
.retry { margin-left: 16rpx; text-decoration: underline; }
