<view class="page">
  <view class="hero">
    <view class="eyebrow">FAFA AUTH DEBUGGER</view>
    <view class="title">微信登录调试台</view>
    <view class="subtitle">获取 wx.login() code，并快速验证 AuthController#login</view>
    <view class="status-pill status-{{statusType}}">{{statusText}}</view>
  </view>

  <view class="card">
    <view class="section-title">后端服务</view>
    <view class="section-description">地址会保存在本机，方便切换开发环境</view>
    <text class="field-label">Base URL</text>
    <input class="url-input" value="{{baseUrl}}" type="text" confirm-type="done" bindinput="onBaseUrlInput" bindconfirm="saveBaseUrl" bindblur="saveBaseUrl" />
    <button class="secondary-button" bindtap="saveBaseUrl">保存地址</button>
  </view>

  <view class="card">
    <view class="section-title">1. 获取微信 code</view>
    <view class="section-description">调用 wx.login() 获取一次性临时凭证</view>
    <view class="code-box">
      <text wx:if="{{code}}" class="code-value">{{code}}</text>
      <text wx:else class="code-value code-placeholder">点击下方按钮获取</text>
    </view>
    <view class="button-row">
      <button class="primary-button" loading="{{isLoadingCode}}" bindtap="refreshCode">{{isLoadingCode ? '获取中...' : '刷新 code'}}</button>
      <button class="secondary-button compact-button" disabled="{{!code}}" bindtap="copyCode">复制 code</button>
    </view>
    <view class="tip">code 只能使用一次。刷新后请使用最新 code，旧 code 不能再次登录。</view>
  </view>

  <view class="card">
    <view class="section-title">2. 调用登录接口</view>
    <view class="section-description">POST {{loginPath}}</view>
    <view class="payload-label">请求体</view>
    <view class="payload"><text class="payload-value">{{requestBody}}</text></view>
    <view class="button-row">
      <button class="primary-button" loading="{{isLoggingIn}}" disabled="{{!code || isLoggingIn}}" bindtap="login">调用登录接口</button>
      <button class="secondary-button compact-button" disabled="{{!code}}" bindtap="copyLoginBody">复制请求体</button>
    </view>
    <view wx:if="{{loginResult}}" class="result-grid">
      <view class="result-item">
        <text class="result-label">用户 ID</text>
        <text class="result-value">{{loginResult.userId}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">是否新用户</text>
        <text class="result-value">{{loginResult.newUser ? '是' : '否'}}</text>
      </view>
    </view>
    <view wx:if="{{loginResponseText}}" class="response-box">
      <text class="response-value">{{loginResponseText}}</text>
    </view>
  </view>

  <view wx:if="{{token}}" class="card">
    <view class="section-title">3. 当前登录态</view>
    <view class="section-description">后续需要登录的接口直接携带以下请求头</view>
    <view class="header-box">
      <text class="header-value">Authorization: {{token}}</text>
    </view>
    <view class="button-row">
      <button class="secondary-button" bindtap="copyToken">复制 token</button>
      <button class="secondary-button" bindtap="copyAuthorization">复制 Authorization</button>
    </view>
  </view>

  <view class="footer">FaFa Java · /auth/wechat/login · Authorization 不需要添加 Bearer 前缀</view>
</view>
