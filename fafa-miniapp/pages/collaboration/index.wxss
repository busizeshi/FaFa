.container { padding: 24rpx; background: #f6f8f7; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 18rpx #0000000b; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 18rpx; }
.muted { color: #78817c; font-size: 24rpx; }
.permission-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.permission { color: #2f7d4f; background: #e6f5ea; border-radius: 20rpx; padding: 8rpx 14rpx; font-size: 22rpx; }
.field, .input { border: 1rpx solid #dce4df; border-radius: 10rpx; padding: 20rpx; margin: 16rpx 0; }
.primary { background: #4caf50; color: white; }
.invitation { word-break: break-all; color: #8a5b00; background: #fff6dc; padding: 18rpx; margin-top: 16rpx; font-size: 22rpx; }
.member { border-top: 1rpx solid #eef1ef; padding: 20rpx 0; position: relative; }
.danger { color: #bd3c32; background: #fff; border: 1rpx solid #e6aaa5; font-size: 22rpx; position: absolute; right: 0; top: 20rpx; }
