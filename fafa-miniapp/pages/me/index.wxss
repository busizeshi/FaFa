.me-page { padding-top: 28rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.me-title { margin: 0 0 28rpx; font-size: 42rpx; font-weight: 700; }
.profile-card { display: flex; align-items: center; padding: 28rpx 22rpx; }
.profile-avatar { display: flex; width: 100rpx; height: 100rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 32rpx; background: #E8F0E4; color: #3E7A52; font-size: 36rpx; font-weight: 650; }
.profile-avatar image { width: 100%; height: 100%; }
.profile-info { flex: 1; margin-left: 20rpx; }
.profile-name { font-size: 30rpx; font-weight: 700; }
.profile-caption { margin-top: 6rpx; color: #7F8D80; font-size: 22rpx; }
.arrow { color: #A0AAA0; font-size: 40rpx; }
.membership-card { display: flex; align-items: center; justify-content: space-between; min-height: 132rpx; padding: 22rpx 28rpx; margin-top: 20rpx; border-radius: 28rpx; background: linear-gradient(120deg, #E6F0E3, #F4F0E5); }
.member-title { color: #355D3E; font-size: 27rpx; font-weight: 700; }
.member-copy { margin-top: 6rpx; color: #708071; font-size: 21rpx; }
.member-arrow { color: #5F8468; font-size: 38rpx; }
.menu-card { padding: 0 22rpx; }
.menu-row { display: flex; height: 102rpx; align-items: center; border-bottom: 1rpx solid #EEF1EB; }
.last-row { border-bottom: 0; }
.menu-icon { display: flex; width: 50rpx; height: 50rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #F0F4EC; color: #5B8664; font-size: 28rpx; }
.family-icon { background: #EEF3F4; color: #4F8497; }
.report-icon { background: #F1EFF7; color: #796CA0; }
.reminder-icon { background: #F7F1E8; color: #AD803D; }
.expense-icon { background: #F8EEE9; color: #BD765A; }
.profile-icon { background: #EEF4ED; color: #5B8664; }
.menu-label { flex: 1; margin-left: 16rpx; font-size: 26rpx; }
.menu-value { margin-right: 10rpx; color: #849185; font-size: 22rpx; }
.me-footer { margin-top: 42rpx; color: #A2ACA2; text-align: center; font-size: 20rpx; }
