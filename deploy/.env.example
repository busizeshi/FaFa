# ==================================================================
# FaFa 开发环境部署变量（复制为 .env 后按需修改；.env 不入库）
#
# 优先级：shell 环境变量 > 本文件 > compose 内的默认值
# ==================================================================

# ---- 镜像标签：由 Jenkins 自动注入 build-<号>，手工部署可留空 ----
IMAGE_TAG=dev

# ---- 网关对外端口（唯一对外端口；服务器 8080 已被 Nacos 控制台占用）----
GATEWAY_PORT=9090

# ---- Nacos（服务发现 + 配置中心）----
NACOS_NAMESPACE=fafa
NACOS_USERNAME=fafa-svc
NACOS_PASSWORD=FafaSvc2026!

# ---- MySQL（单库 fafa）----
MYSQL_USERNAME=fafa
MYSQL_PASSWORD=fafa_123456

# ---- Redis ----
REDIS_PASSWORD=fafa-redis

# ---- RabbitMQ（vhost=/fafa）----
RABBITMQ_USERNAME=fafa
RABBITMQ_PASSWORD=FafaRabbit2026!

# ---- SMTP（163 邮箱验证码发信）----
SMTP_USERNAME=13127103609@163.com
SMTP_PASSWORD=JEfE2tMqVgbWHmij

# ---- AI 服务 ----
PY_LOG_LEVEL=INFO
# DashScope Key 留空则 AI 功能不可用（readyz 标记 NOT_CONFIGURED），不影响服务启动
DASHSCOPE_API_KEY=
