# 仅供本地开发的示例值；共享或生产环境必须替换。
MYSQL_ROOT_PASSWORD=fafa-local-root
MYSQL_PASSWORD=fafa-local-password
MYSQL_ADMIN_PASSWORD=fafa-local-admin-password
REDIS_PASSWORD=fafa-local-redis

# 本地 Compose 中 Nacos 关闭认证，以下为占位值。
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# Nacos 配置分组使用 FAFA_GROUP，命名空间 ID 使用 fafa。
NACOS_NAMESPACE=fafa

# 在本地生成独立随机密钥，各至少 32 字符；Admin 与 Biz 的 RPC 密钥必须一致。
FAFA_AUTH_HMAC_SECRET=
FAFA_INTERNAL_RPC_SECRET=
FAFA_INITIAL_STORAGE_BYTES=0
FAFA_MAIL_FROM=dev@fafa.invalid

MINIO_ROOT_USER=

MINIO_ROOT_PASSWORD=

FAFA_MEDIA_ENDPOINT=

FAFA_MEDIA_PUBLIC_ENDPOINT=

FAFA_MEDIA_ACCESS_KEY=

FAFA_MEDIA_SECRET_KEY=
