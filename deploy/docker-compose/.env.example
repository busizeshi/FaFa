# Local development values only. Replace them for any shared or production environment.
MYSQL_ROOT_PASSWORD=fafa-local-root
MYSQL_PASSWORD=fafa-local-password
REDIS_PASSWORD=fafa-local-redis

# Nacos local compose runs with authentication disabled. These values are placeholders.
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# The namespace ID is empty for the local public namespace. Set an ID outside local dev.
NACOS_NAMESPACE=
