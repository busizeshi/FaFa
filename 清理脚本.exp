#!/usr/bin/expect -f

# 服务器清理 Expect 脚本
# 用法: expect 清理脚本.exp

set timeout 300
set password "JWDdmm@2552"
set server "busizeshi@192.168.1.14"

# 连接服务器
spawn ssh -o StrictHostKeyChecking=no $server

# 等待密码提示
expect {
    "password:" {
        send "$password\r"
    }
    timeout {
        puts "连接超时"
        exit 1
    }
}

# 等待命令提示符
expect {
    "*$" {
        puts "\n=== 已连接到服务器 ===\n"
    }
}

# 执行清理命令
send "echo '=== 开始清理 Docker 环境 ==='\r"
expect "*$"

send "echo '[1/8] 停止所有运行中的容器...'\r"
expect "*$"
send "docker stop \$(docker ps -q) 2>/dev/null || echo '没有运行中的容器'\r"
expect "*$"

send "echo '[2/8] 删除所有容器...'\r"
expect "*$"
send "docker rm -f \$(docker ps -aq) 2>/dev/null || echo '没有容器需要删除'\r"
expect "*$"

send "echo '[3/8] 删除所有镜像...'\r"
expect "*$"
send "docker rmi -f \$(docker images -q) 2>/dev/null || echo '没有镜像需要删除'\r"
expect "*$"
sleep 5

send "echo '[4/8] 删除所有卷...'\r"
expect "*$"
send "docker volume rm \$(docker volume ls -q) 2>/dev/null || echo '没有卷需要删除'\r"
expect "*$"

send "echo '[5/8] 删除自定义网络...'\r"
expect "*$"
send "docker network prune -f\r"
expect "*$"

send "echo '[6/8] 清理 Docker 系统...'\r"
expect "*$"
send "docker system prune -a -f --volumes\r"
expect "*$"
sleep 10

send "echo '[7/8] 删除部署目录...'\r"
expect "*$"
send "echo '$password' | sudo -S rm -rf /home/busizeshi/docker\r"
expect {
    "password" {
        send "$password\r"
        expect "*$"
    }
    "*$" {}
}
send "echo '部署目录已删除'\r"
expect "*$"

send "echo '[8/8] 验证清理结果...'\r"
expect "*$"
send "docker ps -a | wc -l\r"
expect "*$"
send "docker images | wc -l\r"
expect "*$"
send "docker volume ls | wc -l\r"
expect "*$"
send "ls -d /home/busizeshi/docker 2>&1\r"
expect "*$"

send "echo '=== 清理完成 ==='\r"
expect "*$"

send "exit\r"
expect eof
