.form-section {
  padding: 32rpx;
}

.weight-display {
  background: #171A23;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.weight-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.weight-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.weight-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #E5E7EB;
}

.weight-change {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #1E222E;
}

.change-icon {
  font-size: 32rpx;
}

.change-value {
  font-size: 28rpx;
  font-weight: 600;
}

.weight-input {
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  color: #5B8CFF;
}
