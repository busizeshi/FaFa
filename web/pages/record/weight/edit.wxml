<view class="container">
  <view class="form-section">
    <view class="weight-display" wx:if="{{lastWeight}}">
      <view class="weight-info">
        <text class="weight-label">上次记录</text>
        <text class="weight-value">{{lastWeight}} kg</text>
      </view>
      <view class="weight-change" wx:if="{{weightChange}}">
        <text class="change-icon">{{weightChange.isGain ? '↑' : '↓'}}</text>
        <text class="change-value" style="color: {{weightChange.isGain ? '#22D3EE' : '#F87171'}}">
          {{weightChange.value}} kg ({{weightChange.percentage}}%)
        </text>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label input-required">当前体重 (kg)</text>
      <input class="input-field weight-input" type="digit" placeholder="例如：5.2" 
             value="{{formData.weight}}" data-field="weight" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label input-required">测量时间</text>
      <picker mode="time" value="{{formData.measureTime}}" bindchange="onTimeChange">
        <view class="picker-field">
          <text>{{formData.measureTime}}</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">备注</text>
      <textarea class="input-field textarea-field" placeholder="记录一些特别的事情..." 
                value="{{formData.notes}}" data-field="notes" bindinput="onInputChange" 
                maxlength="200"></textarea>
    </view>

    <button class="btn-primary btn-block" bindtap="onSubmit">
      {{isEdit ? '保存修改' : '保存'}}
    </button>

    <button class="btn-danger btn-block" wx:if="{{isEdit}}" bindtap="onDelete">
      删除记录
    </button>
  </view>
</view>
