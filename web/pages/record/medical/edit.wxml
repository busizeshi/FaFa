<view class="container">
  <view class="form-section">
    <view class="input-group">
      <text class="input-label input-required">就诊类型</text>
      <view class="type-grid">
        <view class="type-item" wx:for="{{medicalTypeOptions}}" wx:key="value"
              class="{{formData.medicalType === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="onMedicalTypeChange">
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label input-required">医院名称</text>
      <input class="input-field" type="text" placeholder="例如：爱宠动物医院" 
             value="{{formData.hospital}}" data-field="hospital" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label">医生姓名</text>
      <input class="input-field" type="text" placeholder="例如：张医生" 
             value="{{formData.doctor}}" data-field="doctor" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label input-required">诊断结果</text>
      <textarea class="input-field textarea-field" placeholder="详细记录诊断结果..." 
                value="{{formData.diagnosis}}" data-field="diagnosis" bindinput="onInputChange" 
                maxlength="500"></textarea>
    </view>

    <view class="input-group">
      <text class="input-label">治疗方案</text>
      <textarea class="input-field textarea-field" placeholder="记录治疗方案..." 
                value="{{formData.treatment}}" data-field="treatment" bindinput="onInputChange" 
                maxlength="500"></textarea>
    </view>

    <view class="input-group">
      <text class="input-label">用药记录</text>
      <textarea class="input-field textarea-field" placeholder="记录药品名称、用量、频次..." 
                value="{{formData.medication}}" data-field="medication" bindinput="onInputChange" 
                maxlength="500"></textarea>
    </view>

    <view class="input-group">
      <text class="input-label">费用 (元)</text>
      <input class="input-field" type="digit" placeholder="0" 
             value="{{formData.cost}}" data-field="cost" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label input-required">就诊日期</text>
      <picker mode="date" value="{{formData.visitDate}}" end="{{maxDate}}" bindchange="onVisitDateChange">
        <view class="picker-field">
          <text>{{formData.visitDate}}</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">下次复诊</text>
      <picker mode="date" value="{{formData.nextVisit}}" start="{{formData.visitDate}}" bindchange="onNextVisitChange">
        <view class="picker-field">
          <text wx:if="{{formData.nextVisit}}">{{formData.nextVisit}}</text>
          <text wx:else class="placeholder">请选择复诊日期</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">备注</text>
      <textarea class="input-field textarea-field" placeholder="记录一些特别的事情..." 
                value="{{formData.notes}}" data-field="notes" bindinput="onInputChange" 
                maxlength="200"></textarea>
    </view>

    <button class="btn-primary btn-block" bindtap="onSubmit">
      {{isEdit ? '保存修改' : '保存'}}
    </button>

    <button class="btn-danger btn-block" wx:if="{{isEdit}}" bindtap="onDelete">
      删除记录
    </button>
  </view>
</view>
