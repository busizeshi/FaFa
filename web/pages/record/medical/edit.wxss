.form-section {
  padding: 32rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: #1E222E;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.type-item.active {
  background: rgba(91, 140, 255, 0.15);
  border-color: #5B8CFF;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.type-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.type-item.active .type-label {
  color: #5B8CFF;
}
