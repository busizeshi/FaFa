.header-section {
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #171A23 0%, #1E222E 100%);
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #0F1117;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 64rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #E5E7EB;
}

.user-id {
  font-size: 24rpx;
  color: #6B7280;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 0;
  background: rgba(15, 17, 23, 0.5);
  border-radius: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #5B8CFF;
}

.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #1E222E;
}

.menu-section {
  margin: 24rpx 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #171A23;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.menu-item:last-child {
  margin-bottom: 0;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #E5E7EB;
}

.menu-desc {
  font-size: 24rpx;
  color: #6B7280;
}

.menu-arrow {
  font-size: 48rpx;
  color: #4B5563;
  font-weight: 300;
}

.action-section {
  padding: 32rpx;
}

.btn-logout {
  width: 100%;
  padding: 28rpx;
  background: transparent;
  border: 2rpx solid #374151;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}

.btn-logout::after {
  border: none;
}
