.pet-info {
  display: flex;
  align-items: center;
  background: #171A23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.pet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #1E222E;
}

.pet-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.pet-meta {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.pet-days {
  font-size: 24rpx;
  color: #6B7280;
}

.switch-icon {
  font-size: 48rpx;
  color: #4B5563;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.today-feedings {
  background: #171A23;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.feeding-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1E222E;
}

.feeding-item:last-child {
  border-bottom: none;
}

.feeding-time {
  font-size: 28rpx;
  color: #9CA3AF;
  min-width: 120rpx;
}

.feeding-status {
  color: #22C55E;
  font-size: 32rpx;
  margin: 0 16rpx;
}

.feeding-detail {
  font-size: 28rpx;
  color: #E5E7EB;
}

.quick-feeding-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1E222E;
  border: 2rpx dashed #4B5563;
  border-radius: 12rpx;
  padding: 28rpx;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.reminder-list {
  background: #171A23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1E222E;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-icon {
  font-size: 32rpx;
  color: #6B7280;
  margin-right: 16rpx;
}

.reminder-title {
  flex: 1;
  font-size: 28rpx;
  color: #E5E7EB;
}

.reminder-action {
  font-size: 26rpx;
  color: #5B8CFF;
  padding: 8rpx 20rpx;
  background: rgba(91, 140, 255, 0.1);
  border-radius: 20rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #171A23;
  border-radius: 16rpx;
  padding: 32rpx 0;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-name {
  font-size: 26rpx;
  color: #9CA3AF;
}

.ai-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1E222E 0%, #171A23 100%);
  border: 1rpx solid rgba(91, 140, 255, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
}

.ai-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.ai-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ai-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.ai-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

.ai-arrow {
  font-size: 48rpx;
  color: #5B8CFF;
}

.memory-card {
  position: relative;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.memory-image {
  width: 100%;
  height: 100%;
}

.memory-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
  padding: 32rpx 24rpx 24rpx;
}

.memory-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.5;
}
