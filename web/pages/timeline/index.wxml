<view class="container">
  <view class="filter-tabs">
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-list">
        <view class="filter-item" wx:for="{{recordTypes}}" wx:key="value"
              class="{{filterType === item.value ? 'active' : ''}}"
              data-type="{{item.value}}" bindtap="onFilterChange">
          <text class="filter-icon">{{item.icon}}</text>
          <text class="filter-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="timeline-container">
    <view class="date-group" wx:for="{{groupedRecords}}" wx:key="date">
      <view class="date-header">
        <text class="date-label">{{item.dateLabel}}</text>
        <text class="date-value">{{item.date}}</text>
      </view>

      <view class="timeline-list">
        <view class="timeline-item" wx:for="{{item.records}}" wx:key="id" wx:for-item="record"
              data-id="{{record.id}}" data-type="{{record.type}}" bindtap="onRecordTap">
          <view class="timeline-dot"></view>
          <view class="timeline-line"></view>
          <view class="record-card">
            <view class="record-header">
              <view class="record-type">
                <text class="record-icon">{{getRecordTypeIcon(record.type)}}</text>
                <text class="record-title">{{getRecordTypeText(record.type)}}</text>
              </view>
              <text class="record-time">{{formatTime(record.recordDate)}}</text>
            </view>
            <view class="record-content" wx:if="{{record.summary}}">
              <text class="record-summary">{{record.summary}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!loading && groupedRecords.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无记录</text>
      <text class="empty-hint">点击右下角按钮添加记录</text>
    </view>

    <view class="loading-more" wx:if="{{loading && groupedRecords.length > 0}}">
      <text>加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && groupedRecords.length > 0}}">
      <text>没有更多了</text>
    </view>
  </view>

  <view class="fab-button" bindtap="onAddRecord">
    <text class="fab-icon">+</text>
  </view>
</view>
