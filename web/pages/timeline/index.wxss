.filter-tabs {
  background: #0F1117;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1E222E;
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.filter-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #1E222E;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.filter-item.active {
  background: rgba(91, 140, 255, 0.15);
  border-color: #5B8CFF;
}

.filter-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.filter-label {
  font-size: 22rpx;
  color: #9CA3AF;
  white-space: nowrap;
}

.filter-item.active .filter-label {
  color: #5B8CFF;
}

.timeline-container {
  padding: 0 32rpx 120rpx;
}

.date-group {
  margin-top: 32rpx;
}

.date-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.date-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #E5E7EB;
}

.date-value {
  font-size: 24rpx;
  color: #6B7280;
}

.timeline-list {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: 48rpx;
  margin-bottom: 32rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #5B8CFF;
  z-index: 2;
}

.timeline-line {
  position: absolute;
  left: 7rpx;
  top: 28rpx;
  bottom: -32rpx;
  width: 2rpx;
  background: #1E222E;
  z-index: 1;
}

.record-card {
  background: #171A23;
  border-radius: 12rpx;
  padding: 24rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-type {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-icon {
  font-size: 32rpx;
}

.record-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #E5E7EB;
}

.record-time {
  font-size: 24rpx;
  color: #6B7280;
}

.record-summary {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.5;
}

.fab-button {
  position: fixed;
  right: 32rpx;
  bottom: 96rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #5B8CFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 140, 255, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 24rpx;
  color: #6B7280;
}
