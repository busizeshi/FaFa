.profile-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #171A23;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-right: 32rpx;
  background: #1E222E;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.profile-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: rgba(91, 140, 255, 0.15);
  color: #5B8CFF;
  border-radius: 12rpx;
}

.profile-breed {
  font-size: 26rpx;
  color: #9CA3AF;
}

.statistics-row {
  display: flex;
  justify-content: space-around;
  background: #171A23;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #5B8CFF;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.detail-section {
  background: #171A23;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #1E222E;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #9CA3AF;
}

.detail-value {
  font-size: 28rpx;
  color: #E5E7EB;
  font-weight: 500;
}

.notes-card {
  background: #171A23;
  border-radius: 16rpx;
  padding: 24rpx;
}

.notes-text {
  font-size: 28rpx;
  color: #E5E7EB;
  line-height: 1.6;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #1E222E;
}

.record-list {
  background: #171A23;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #1E222E;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-title {
  font-size: 28rpx;
  color: #E5E7EB;
  margin-bottom: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: #6B7280;
}

.record-arrow {
  font-size: 48rpx;
  color: #4B5563;
}

.action-buttons {
  margin-top: 32rpx;
  padding-bottom: 32rpx;
}

.btn-block {
  width: 100%;
  margin-bottom: 16rpx;
}

.btn-danger {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
  border: 1rpx solid rgba(239, 68, 68, 0.3);
}
