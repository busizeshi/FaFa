<view class="container" wx:if="{{!loading && pet}}">
  <view class="profile-header">
    <image class="profile-avatar" src="{{pet.avatar}}" mode="aspectFill"></image>
    <view class="profile-info">
      <text class="profile-name">{{pet.name}}</text>
      <view class="profile-tags">
        <text class="tag">{{getSpeciesText(pet.species)}}</text>
        <text class="tag">{{getGenderText(pet.gender)}}</text>
        <text class="tag">{{getAge(pet.birthDate)}}</text>
      </view>
      <text class="profile-breed" wx:if="{{pet.breed}}">{{pet.breed}}</text>
    </view>
  </view>

  <view class="statistics-row">
    <view class="stat-item">
      <text class="stat-value">{{statistics.photoCount}}</text>
      <text class="stat-label">照片</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{statistics.recordCount}}</text>
      <text class="stat-label">记录</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{statistics.daysSince}}</text>
      <text class="stat-label">天</text>
    </view>
  </view>

  <view class="detail-section">
    <view class="detail-row">
      <text class="detail-label">体重</text>
      <text class="detail-value">{{pet.weight}}kg</text>
    </view>
    <view class="detail-row" wx:if="{{pet.birthDate}}">
      <text class="detail-label">出生日期</text>
      <text class="detail-value">{{pet.birthDate}}</text>
    </view>
    <view class="detail-row" wx:if="{{pet.adoptDate}}">
      <text class="detail-label">到家日期</text>
      <text class="detail-value">{{pet.adoptDate}}</text>
    </view>
    <view class="detail-row" wx:if="{{pet.furColor}}">
      <text class="detail-label">毛色</text>
      <text class="detail-value">{{pet.furColor}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">绝育状态</text>
      <text class="detail-value">{{pet.isNeutered ? '已绝育' : '未绝育'}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{pet.notes}}">
    <view class="section-title">备注</view>
    <view class="notes-card">
      <text class="notes-text">{{pet.notes}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{recentPhotos.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近照片</text>
      <text class="section-action" bindtap="onViewAllPhotos">查看全部 ›</text>
    </view>
    <view class="photo-grid">
      <image class="photo-item" wx:for="{{recentPhotos}}" wx:key="id"
             src="{{item.thumbnailUrl}}" mode="aspectFill"
             data-id="{{item.id}}" bindtap="onPhotoTap"></image>
    </view>
  </view>

  <view class="section" wx:if="{{recentRecords.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近记录</text>
      <text class="section-action" bindtap="onViewTimeline">查看更多 ›</text>
    </view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id"
            data-id="{{item.id}}" data-type="{{item.type}}" bindtap="onRecordTap">
        <text class="record-icon">{{getRecordTypeIcon(item.type)}}</text>
        <view class="record-content">
          <text class="record-title">{{getRecordTypeText(item.type)}}</text>
          <text class="record-date">{{formatDate(item.recordDate)}}</text>
        </view>
        <text class="record-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn-secondary btn-block" bindtap="onEdit">编辑资料</button>
    <button class="btn-ghost btn-block" bindtap="onShare" open-type="share">分享档案</button>
    <button class="btn-danger btn-block" bindtap="onDelete">删除档案</button>
  </view>
</view>

<view class="loading-state" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
