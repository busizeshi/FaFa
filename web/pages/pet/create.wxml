<view class="container">
  <view class="progress-bar">
    <view class="progress-step" class="{{step >= 1 ? 'active' : ''}}">
      <view class="step-number">1</view>
      <text class="step-text">基本信息</text>
    </view>
    <view class="progress-line" class="{{step >= 2 ? 'active' : ''}}"></view>
    <view class="progress-step" class="{{step >= 2 ? 'active' : ''}}">
      <view class="step-number">2</view>
      <text class="step-text">详细档案</text>
    </view>
  </view>

  <view class="form-section" wx:if="{{step === 1}}">
    <view class="section-hint">几十秒完成建档</view>

    <view class="input-group">
      <text class="input-label input-required">宠物昵称</text>
      <input class="input-field" type="text" placeholder="给它起个名字" 
             value="{{formData.name}}" data-field="name" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label input-required">种类</text>
      <view class="radio-group">
        <view class="radio-item" wx:for="{{speciesOptions}}" wx:key="value"
              class="{{formData.species === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="onSpeciesChange">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label input-required">性别</text>
      <view class="radio-group">
        <view class="radio-item" wx:for="{{genderOptions}}" wx:key="value"
              class="{{formData.gender === item.value ? 'active' : ''}}"
              data-value="{{item.value}}" bindtap="onGenderChange">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label input-required">出生日期</text>
      <picker mode="date" value="{{formData.birthDate}}" end="{{maxDate}}" bindchange="onBirthDateChange">
        <view class="picker-field">
          <text wx:if="{{formData.birthDate}}">{{formData.birthDate}}</text>
          <text wx:else class="placeholder">请选择出生日期</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label input-required">当前体重 (kg)</text>
      <input class="input-field" type="digit" placeholder="例如：5.2" 
             value="{{formData.weight}}" data-field="weight" bindinput="onInputChange" />
    </view>

    <button class="btn-primary btn-block" bindtap="onNextStep">下一步</button>
  </view>

  <view class="form-section" wx:if="{{step === 2}}">
    <view class="section-hint">完善更多信息（可跳过）</view>

    <view class="input-group">
      <text class="input-label">头像</text>
      <view class="avatar-upload" bindtap="onChooseAvatar">
        <image wx:if="{{formData.avatar}}" class="avatar-preview" src="{{formData.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="upload-icon">📷</text>
          <text class="upload-text">{{uploading ? '上传中...' : '点击上传'}}</text>
        </view>
      </view>
    </view>

    <view class="input-group">
      <text class="input-label">品种</text>
      <input class="input-field" type="text" placeholder="例如：英国短毛猫" 
             value="{{formData.breed}}" data-field="breed" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label">到家日期</text>
      <picker mode="date" value="{{formData.adoptDate}}" end="{{maxDate}}" bindchange="onAdoptDateChange">
        <view class="picker-field">
          <text wx:if="{{formData.adoptDate}}">{{formData.adoptDate}}</text>
          <text wx:else class="placeholder">请选择到家日期</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">是否绝育</text>
      <switch color="#5B8CFF" checked="{{formData.isNeutered}}" bindchange="onNeuteredChange" />
    </view>

    <view class="input-group">
      <text class="input-label">毛色</text>
      <input class="input-field" type="text" placeholder="例如：蓝白" 
             value="{{formData.furColor}}" data-field="furColor" bindinput="onInputChange" />
    </view>

    <view class="input-group">
      <text class="input-label">备注</text>
      <textarea class="input-field textarea-field" placeholder="记录一些特别的事情..." 
                value="{{formData.notes}}" data-field="notes" bindinput="onInputChange" 
                maxlength="500"></textarea>
    </view>

    <view class="button-group">
      <button class="btn-secondary" bindtap="onPrevStep">上一步</button>
      <button class="btn-ghost" bindtap="onSkipStep2">跳过</button>
      <button class="btn-primary" bindtap="submitForm">完成</button>
    </view>
  </view>
</view>
