.progress-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
  transition: opacity 0.3s;
}

.progress-step.active {
  opacity: 1;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1E222E;
  color: #9CA3AF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.progress-step.active .step-number {
  background: #5B8CFF;
  color: #FFFFFF;
}

.step-text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.progress-line {
  width: 120rpx;
  height: 2rpx;
  background: #1E222E;
  margin: 0 24rpx;
  margin-bottom: 40rpx;
  transition: background 0.3s;
}

.progress-line.active {
  background: #5B8CFF;
}

.form-section {
  padding: 0 32rpx 32rpx;
}

.section-hint {
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
}

.radio-group {
  display: flex;
  gap: 16rpx;
}

.radio-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #1E222E;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  color: #9CA3AF;
  font-size: 28rpx;
  transition: all 0.2s;
}

.radio-item.active {
  background: rgba(91, 140, 255, 0.15);
  border-color: #5B8CFF;
  color: #5B8CFF;
}

.picker-field {
  background: #1E222E;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  color: #E5E7EB;
  font-size: 28rpx;
}

.picker-field .placeholder {
  color: #6B7280;
}

.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #1E222E;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #4B5563;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #6B7280;
}

.textarea-field {
  min-height: 160rpx;
  line-height: 1.6;
}

.btn-block {
  width: 100%;
  margin-top: 48rpx;
}

.button-group {
  display: flex;
  gap: 16rpx;
  margin-top: 48rpx;
}

.button-group .btn-secondary {
  flex: 1;
}

.button-group .btn-ghost {
  flex: 1;
}

.button-group .btn-primary {
  flex: 2;
}
