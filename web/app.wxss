page {
  background: #0F1117;
  color: #E5E7EB;
  font-family: -apple-system-font, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  font-size: 28rpx;
}

button::after {
  border: none;
}

.container {
  min-height: 100vh;
  padding: 0 32rpx 32rpx;
}

.page-header {
  padding: 32rpx 0;
  position: sticky;
  top: 0;
  background: #0F1117;
  z-index: 100;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.card {
  background: #171A23;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.card-action {
  font-size: 26rpx;
  color: #5B8CFF;
}

.divider {
  height: 1rpx;
  background: #1E222E;
  margin: 24rpx 0;
}

.btn-primary {
  background: #5B8CFF;
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-secondary {
  background: #1E222E;
  color: #E5E7EB;
  border-radius: 12rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #5B8CFF;
  border: 2rpx solid #5B8CFF;
  border-radius: 12rpx;
  padding: 22rpx 46rpx;
  font-size: 30rpx;
}

.btn-text {
  background: transparent;
  color: #5B8CFF;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  border: none;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.input-field {
  background: #1E222E;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  color: #E5E7EB;
  font-size: 28rpx;
}

.input-field:focus {
  border-color: #5B8CFF;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
  display: block;
}

.input-required::after {
  content: '*';
  color: #F87171;
  margin-left: 4rpx;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-primary {
  background: rgba(91, 140, 255, 0.15);
  color: #5B8CFF;
}

.tag-success {
  background: rgba(34, 197, 94, 0.15);
  color: #22C55E;
}

.tag-warning {
  background: rgba(251, 191, 36, 0.15);
  color: #FBBF24;
}

.tag-error {
  background: rgba(248, 113, 113, 0.15);
  color: #F87171;
}

.empty-state {
  text-align: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #4B5563;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 32rpx;
}

.loading-state {
  text-align: center;
  padding: 80rpx 32rpx;
  color: #6B7280;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #171A23;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.list-item-active {
  background: #1E222E;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #1E222E;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-small {
  width: 56rpx;
  height: 56rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  background: #F87171;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 20rpx;
  text-align: center;
  padding: 0 8rpx;
}

.flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.text-primary {
  color: #5B8CFF;
}

.text-secondary {
  color: #9CA3AF;
}

.text-success {
  color: #22C55E;
}

.text-warning {
  color: #FBBF24;
}

.text-error {
  color: #F87171;
}

.text-bold {
  font-weight: 600;
}

.text-center {
  text-align: center;
}

.mt-8 { margin-top: 16rpx; }
.mt-12 { margin-top: 24rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }

.mb-8 { margin-bottom: 16rpx; }
.mb-12 { margin-bottom: 24rpx; }
.mb-16 { margin-bottom: 32rpx; }
.mb-24 { margin-bottom: 48rpx; }

.pt-8 { padding-top: 16rpx; }
.pt-12 { padding-top: 24rpx; }
.pt-16 { padding-top: 32rpx; }

.pb-8 { padding-bottom: 16rpx; }
.pb-12 { padding-bottom: 24rpx; }
.pb-16 { padding-bottom: 32rpx; }
