<?xml version="1.0" encoding="UTF-8"?>
<!--
  fafa-gateway 日志配置

  约定（架构规范 §11.2）：
    - 开发期输出人类可读格式；traceId/spanId 由 micrometer-tracing 写入 MDC；
      requestId 由 RequestIdGlobalFilter 写入 MDC（下游同理），便于全链路检索；
    - 生产改为 stdout JSON 结构化（字段：timestamp/level/service/traceId/requestId/...），
      由 Loki 采集，本文件仅调整 pattern，不改采集架构。
-->
<configuration>

    <!-- 引用 spring.application.name，避免硬编码 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="fafa-gateway"/>

    <!-- 控制台输出：含时间、级别、traceId、spanId、requestId、线程、logger -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [traceId=%X{traceId:-}] [spanId=%X{spanId:-}] [requestId=%X{requestId:-}] [%thread] %logger{40} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 开发环境：com.fafa 包 DEBUG 便于排查；其余 INFO -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.fafa" level="DEBUG"/>
    </springProfile>

    <!-- 生产环境：INFO 为主 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
