<?xml version="1.0" encoding="UTF-8"?>
<!--
  fafa-biz：产品业务服务（宠主 API 唯一业务事实所有者）

  职责边界（架构规范 §4.3）：
    - 身份与家庭权限、宠物档案、照护任务、食品/医疗、媒体与回忆、社区、隐私、AI 门面、通知；
    - 所有正式业务写操作的唯一入口；admin 对业务字典/规则的修改必须调用 biz 后台 API。

  内部按 bounded context 分包（identity / family / care / food / media / community /
  privacy / ai / notification），每个上下文内按 interfaces / application / domain /
  infrastructure 四层组织，见 com.fafa.biz.interfaces.package-info 等说明。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fafa</groupId>
        <artifactId>fafa-java</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fafa-biz</artifactId>
    <packaging>jar</packaging>
    <name>FaFa Biz</name>
    <description>FaFa 产品业务服务：身份、家庭、宠物、照护、食品医疗、媒体、社区、隐私、AI 门面与通知</description>

    <dependencies>
        <!-- ===== Web 与校验 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ===== AOP：@RateLimit 限流切面（@Aspect 需要 aspectjweaver） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ===== 注册中心与配置中心（Nacos） ===== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ===== Dubbo：Java 服务间强类型同步 RPC（admin → biz 等），Triple 协议 ===== -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>

        <!-- ===== 持久化：MyBatis-Plus + MySQL + Flyway ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 拦截器（分页/防全表攻击），3.5.9 起独立模块 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 的 MySQL 方言模块（Flyway 10 起拆分） -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ===== Redis：Sa-Token 会话共享、短期缓存、限流 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===== RabbitMQ：异步任务与领域事件（Outbox 发布 / 消费） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ===== 认证基础：Sa-Token（宠主会话） + Redis 会话共享（与 Gateway 共用存储） ===== -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Sa-Token 会话数据写入 Redis（与网关共享，见中间件文档 §4.2） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>

        <!-- ===== 密码哈希：spring-security-crypto（仅 BCrypt 工具类，不引 Security 全家桶） ===== -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ===== SMTP 邮件：验证码 / 密码重置（M00，163 邮箱） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ===== API 文档：springdoc-openapi（契约事实来源）+ Knife4j（doc.html 增强 UI） ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- ===== 工具：Hutool（小范围通用工具，禁止承载业务规则） ===== -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- ===== 运维观测 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- ===== 内部公共契约库 ===== -->
        <dependency>
            <groupId>com.fafa</groupId>
            <artifactId>fafa-common</artifactId>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.fafa.biz.BizApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
