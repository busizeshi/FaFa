<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fafa.infrastructure.persistence.mapper.FeedRecordMapper">
    
    <select id="countByPetIdAndDateRange" resultType="int">
        SELECT COUNT(*)
        FROM feed_record
        WHERE pet_id = #{petId}
        AND is_deleted = 0
        <if test="startDate != null">
            AND DATE(feed_time) >= #{startDate}
        </if>
        <if test="endDate != null">
            AND DATE(feed_time) &lt;= #{endDate}
        </if>
    </select>
    
</mapper>
