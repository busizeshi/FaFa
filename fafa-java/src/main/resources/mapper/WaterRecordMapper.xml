<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fafa.infrastructure.persistence.mapper.WaterRecordMapper">
    
    <select id="sumAmountByPetIdAndDateRange" resultType="int">
        SELECT COALESCE(SUM(amount), 0)
        FROM water_record
        WHERE pet_id = #{petId}
        <if test="startDate != null">
            AND DATE(water_time) >= #{startDate}
        </if>
        <if test="endDate != null">
            AND DATE(water_time) &lt;= #{endDate}
        </if>
    </select>
    
</mapper>
