# 中间件配置（部署在服务器上）
# MySQL
MYSQL_HOST=your_server_ip
MYSQL_PORT=3306
MYSQL_DATABASE=fafa
MYSQL_USERNAME=fafa_user
MYSQL_PASSWORD=your_mysql_password

# Redis
REDIS_HOST=your_server_ip
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Qdrant
QDRANT_HOST=your_server_ip
QDRANT_PORT=6333

# RocketMQ
ROCKETMQ_HOST=your_server_ip
ROCKETMQ_PORT=9876

# MinIO
MINIO_ENDPOINT=http://your_server_ip:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# 通义千问 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key
